{
  "name": "cms",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "node scripts/clear-stale-next-dev-lock.mjs && cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed:pages": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-fixed-pages.ts",
    "seed:blog": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-blog-posts.ts",
    "seed:shell": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-shell-globals.ts",
    "verify:pages": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/verify-pages-seed.ts",
    "verify:individuals-css": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/verify-individuals-css.ts",
    "verify:security": "node scripts/verify-security-advisories.mjs && npm audit --audit-level=high",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.86.0",
    "@payloadcms/live-preview-react": "^3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.12",
    "payload": "3.86.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "balanced-match": "^4.0.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.12",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.23.1",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "$sharp",
    "mongoose": "^8.24.2",
    "brace-expansion": "file:vendor/brace-expansion",
    "fast-uri": "3.1.5",
    "undici": "7.29.0",
    "js-yaml": "4.3.1"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.25",
      "sharp": "0.35.3",
      "mongoose": "^8.24.2",
      "brace-expansion": "file:vendor/brace-expansion",
      "fast-uri": "3.1.5",
      "undici": "7.29.0",
      "js-yaml": "4.3.1"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
