# MongoDB (Compose service hostname is `mongo`; local dev often uses 127.0.0.1)
DATABASE_URL=mongodb://127.0.0.1:27017/payload

PAYLOAD_SECRET=replace-with-long-random-string

# Used by Payload serverURL and previews
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Draft preview: required for admin Preview / Live Preview (/api/draft). Use a long random string.
PREVIEW_SECRET=replace-with-long-random-string

# Set to true to show the dev "Enter preview mode" bar on the public site (off by default).
# SHOW_PREVIEW_RESUME_BAR=true

# Set to true to block search engines (noindex, empty sitemap, robots.txt disallow).
# NO_INDEX=true

# Optional: Disqus shortname for blog posts
# NEXT_PUBLIC_DISQUS_SHORTNAME=
