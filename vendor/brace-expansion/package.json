{
  "name": "brace-expansion",
  "version": "5.0.8",
  "description": "Vendored brace-expansion@5.0.8 with a callable CJS export so minimatch@3 (eslint plugins) keeps working while npm audit sees the patched version (GHSA-mh99-v99m-4gvg).",
  "license": "MIT",
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "dependencies": {
    "balanced-match": "^4.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
